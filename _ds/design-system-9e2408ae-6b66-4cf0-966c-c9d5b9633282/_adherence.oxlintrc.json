{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/catalog/**",
              "components/community/**",
              "components/content/**",
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/quiz/**",
              "ui_kits/mobile/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Marck Script|Montserrat|Source Serif 4))/i]",
        "message": "Font not provided by the design system. Available: Inter, Marck Script, Montserrat, Source Serif 4."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|title|content|expandable|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: id, title, content, expandable."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerFeedback'] > JSXAttribute > JSXIdentifier[name!=/^(?:correct|title|children|details|moreLabel|reportLabel|onReport|key|ref|className|style|children)$/]",
        "message": "<AnswerFeedback> doesn't accept that prop. Declared props: correct, title, children, details, moreLabel, reportLabel, onReport."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|children|selected|status|disabled|key|ref|className|style|children)$/]",
        "message": "<AnswerOption> doesn't accept that prop. Declared props: letter, children, selected, status, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerOption'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:correct|incorrect)$/]",
        "message": "<AnswerOption> status must be one of 'correct' | 'incorrect'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:initials|tone|size|logo|src|alt|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: initials, tone, size, logo, src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:forest|violet|green|blue|amber)$/]",
        "message": "<Avatar> tone must be one of 'forest' | 'violet' | 'green' | 'blue' | 'amber'."
      },
